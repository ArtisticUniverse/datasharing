rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Original receipts are private to the uploader; donors only see redacted images.
    match /receipts/{uid}/{file} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.admin == true);
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
    }
    match /redacted/{billId}/{file} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
